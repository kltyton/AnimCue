{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "icon": "assets/interactive_animation/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["${mod_java_package}.platform.fabric.InteractiveAnimationFabric"],
    "client": ["${mod_java_package}.platform.fabric.InteractiveAnimationFabricClient"]
  },
  "mixins": ["interactive_animation.mixins.json", "interactive_animation.render.mixins.json"],
  "depends": {
    "fabricloader": "${loader_version_range}",
    "minecraft": "${fabric_minecraft_version_range}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  }
}
